{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types",
      "../../ejercicios-basicos/node_modules/@types"
    ],
    "types": ["node"],
    "paths": {
      "vite": [
        "./node_modules/vite/dist/node/index.d.ts",
        "../node_modules/vite/dist/node/index.d.ts",
        "../../ejercicios-basicos/node_modules/vite/dist/node/index.d.ts"
      ],
      "@vitejs/plugin-react": [
        "./node_modules/@vitejs/plugin-react/dist/index.d.ts",
        "../node_modules/@vitejs/plugin-react/dist/index.d.ts",
        "../../ejercicios-basicos/node_modules/@vitejs/plugin-react/dist/index.d.ts"
      ],
      "@rolldown/plugin-babel": [
        "./node_modules/@rolldown/plugin-babel/dist/index.d.mts",
        "../node_modules/@rolldown/plugin-babel/dist/index.d.mts",
        "../../ejercicios-basicos/node_modules/@rolldown/plugin-babel/dist/index.d.mts"
      ],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*",
        "../node_modules/@types/*",
        "../node_modules/*",
        "../../ejercicios-basicos/node_modules/@types/*",
        "../../ejercicios-basicos/node_modules/*"
      ]
    },
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
