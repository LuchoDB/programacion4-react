{
  "compilerOptions": {
    
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types",
      "../../ejercicios-basicos/node_modules/@types",
      "../../ejercicios-basicos/node_modules"
    ],
    "types": ["vite/client"],
    "paths": {
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*",
        "../node_modules/@types/*",
        "../node_modules/*",
        "../../ejercicios-basicos/node_modules/@types/*",
        "../../ejercicios-basicos/node_modules/*"
      ]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}

